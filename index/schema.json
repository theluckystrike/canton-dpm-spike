{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theluckystrike/canton-dpm-spike/index/schema.json",
  "title": "Canton DPM component index entry",
  "description": "One publishable DPM component. The index is a static JSON list so a component can be reviewed without running any service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "component_kind",
    "daml_sdk_version",
    "entry_point",
    "integrity",
    "license",
    "maintainer",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "Kebab-case unique identifier."
    },
    "display_name": { "type": "string", "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "component_kind": {
      "enum": ["template-plugin", "scaffold", "ledger-api-adapter", "ui-block"]
    },
    "daml_sdk_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Daml SDK the component compiles against."
    },
    "entry_point": {
      "type": "string",
      "pattern": "^(oci://[a-z0-9.-]+(:\\d+)?/[a-z0-9._/-]+(:[A-Za-z0-9._-]+|@sha256:[a-f0-9]{64})|(\\./|components/|index/)[A-Za-z0-9._/-]+)$",
      "description": "OCI reference with an explicit tag, or a repository-relative path."
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "license": { "type": "string", "minLength": 3, "description": "SPDX identifier." },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": ["ledger-read", "ledger-write", "party-allocate", "user-create", "external-network"]
      },
      "uniqueItems": true
    },
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "url": { "type": "string", "format": "uri" },
        "contact": { "type": "string", "minLength": 3 }
      }
    },
    "description": { "type": "string", "minLength": 20, "maxLength": 600 },
    "examples": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5
    }
  }
}
